<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.webcrawler.ui.StatisticsTabController"
      spacing="12"
      styleClass="tab-content">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <HBox styleClass="card" spacing="10" alignment="CENTER_LEFT">
        <Label text="Сесія для аналізу:" styleClass="field-label"/>
        <ComboBox fx:id="sessionSelectorComboBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="refreshButton" text="Оновити"
                onAction="#onRefreshClicked" styleClass="btn-secondary"/>
    </HBox>

    <VBox fx:id="emptyStateBox" styleClass="empty-state-card" alignment="CENTER" spacing="8"
          VBox.vgrow="ALWAYS" visible="false" managed="false">
        <Label text="Статистика обходу наразі відсутня" styleClass="empty-title"/>
        <Label text="У базі даних ще немає жодної сесії обходу. Запустіть локальний або розподілений обхід на вкладці «Обхід», щоб побачити зібрані метрики та метадані сторінок."
               styleClass="empty-subtitle" wrapText="true" maxWidth="560"/>
    </VBox>

    <VBox fx:id="contentContainer" spacing="12" VBox.vgrow="ALWAYS">
        <HBox spacing="10">
            <VBox styleClass="kpi-card, kpi-visited" spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Відвідано сторінок" styleClass="kpi-title"/>
                <Label fx:id="visitedKpiLabel" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox styleClass="kpi-card, kpi-matched" spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Знайдено збігів" styleClass="kpi-title"/>
                <Label fx:id="matchedKpiLabel" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox styleClass="kpi-card, kpi-errors" spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Помилок" styleClass="kpi-title"/>
                <Label fx:id="errorsKpiLabel" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox styleClass="kpi-card, kpi-bytes" spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Загальний обсяг (байт)" styleClass="kpi-title"/>
                <HBox spacing="8" alignment="BASELINE_LEFT">
                    <Label fx:id="totalBytesKpiLabel" text="0" styleClass="kpi-value"/>
                    <Label fx:id="totalBytesHumanLabel" text="(0 Б)" styleClass="muted-label"/>
                </HBox>
            </VBox>
        </HBox>

        <Label fx:id="cumulativeSummaryLabel" text="" styleClass="summary-strip" maxWidth="Infinity"/>

        <SplitPane orientation="VERTICAL" dividerPositions="0.48" VBox.vgrow="ALWAYS"
                   styleClass="analytics-split-pane">
            <items>
                <SplitPane orientation="HORIZONTAL" dividerPositions="0.42"
                           styleClass="analytics-split-pane">
                    <items>
                        <VBox styleClass="card" spacing="8">
                            <Label text="Розподіл відвіданих сторінок за хостами" styleClass="section-title"/>
                            <PieChart fx:id="hostPieChart" animated="false"
                                      labelsVisible="true" legendSide="BOTTOM"
                                      VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <VBox styleClass="card" spacing="8">
                            <Label text="Показники за веб-сайтами (хостами)" styleClass="section-title"/>
                            <TableView fx:id="hostTable" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="hostColumn" text="Домен" prefWidth="170"/>
                                    <TableColumn fx:id="hostVisitedColumn" text="Усього сторінок" prefWidth="110"/>
                                    <TableColumn fx:id="hostMatchedColumn" text="Збігів" prefWidth="80"/>
                                    <TableColumn fx:id="hostErrorColumn" text="Помилок" prefWidth="80"/>
                                    <TableColumn fx:id="hostBytesColumn" text="Обсяг (байт)" prefWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </items>
                </SplitPane>

                <VBox styleClass="card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Метадані відвіданих сторінок" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="pagesCountLabel" text="0 записів" styleClass="muted-label"/>
                    </HBox>
                    <TableView fx:id="pagesTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="pageUrlColumn" text="Адреса" prefWidth="230"/>
                            <TableColumn fx:id="pageTitleColumn" text="Заголовок" prefWidth="160"/>
                            <TableColumn fx:id="pageDateColumn" text="Дата завантаження" prefWidth="135"/>
                            <TableColumn fx:id="pageSizeColumn" text="Розмір (байт)" prefWidth="95"/>
                            <TableColumn fx:id="pageDepthColumn" text="Глибина" prefWidth="70"/>
                            <TableColumn fx:id="pageStatusColumn" text="HTTP-статус" prefWidth="85"/>
                            <TableColumn fx:id="pageHasTermColumn" text="Збіг" prefWidth="65"/>
                            <TableColumn fx:id="pageErrorColumn" text="Помилка" prefWidth="150"/>
                            <TableColumn fx:id="pageFilePathColumn" text="Шлях до файлу" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </VBox>

</VBox>
