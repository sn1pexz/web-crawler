<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.webcrawler.ui.CrawlTabController"
           orientation="HORIZONTAL"
           dividerPositions="0.48"
           styleClass="crawl-split-pane">

    <items>
        <ScrollPane fitToWidth="true" minWidth="440" styleClass="edge-to-edge-scroll">
            <content>
                <VBox spacing="12">
                    <padding>
                        <Insets top="14" right="12" bottom="14" left="14"/>
                    </padding>

                    <VBox styleClass="card" spacing="10">
                        <Label text="Параметри обходу" styleClass="section-title"/>

                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="135" prefWidth="145"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                            </columnConstraints>

                            <Label text="Стартова адреса:" styleClass="field-label"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="startUrlField" promptText="https://example.com"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Термін пошуку:" styleClass="field-label"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="searchTermField"
                                       promptText="Введіть ключове слово або фразу"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Стратегія обходу:" styleClass="field-label"
                                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="strategyComboBox" maxWidth="Infinity"
                                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Обмеження:" styleClass="field-label"
                                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <HBox spacing="10" alignment="CENTER_LEFT"
                                  GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <Label text="Глибина:"/>
                                <Spinner fx:id="maxDepthSpinner" editable="true" prefWidth="86"/>
                                <Label text="Ліміт сторінок:"/>
                                <Spinner fx:id="pageLimitSpinner" editable="true" prefWidth="96"/>
                            </HBox>
                        </GridPane>

                        <FlowPane hgap="16" vgap="6">
                            <CheckBox fx:id="wholeWordCheckBox" text="Ціле слово"/>
                            <CheckBox fx:id="includeSubdomainsCheckBox" text="Включати піддомени">
                                <tooltip>
                                    <Tooltip text="Якщо вимкнено — обхід виконується лише в межах стартового хоста"/>
                                </tooltip>
                            </CheckBox>
                            <CheckBox fx:id="respectRobotsCheckBox" text="Дотримуватися robots.txt"
                                      selected="true" disable="true">
                                <tooltip>
                                    <Tooltip text="Перевірка robots.txt та дотримання інтервалу запитів увімкнені постійно (NFR-04)"/>
                                </tooltip>
                            </CheckBox>
                        </FlowPane>

                        <Separator/>

                        <Label text="Фільтри несемантичних елементів" styleClass="field-label"/>
                        <FlowPane hgap="14" vgap="6">
                            <CheckBox fx:id="scriptFilterCheckBox" text="Скрипти (script, noscript)"/>
                            <CheckBox fx:id="styleFilterCheckBox" text="Стилі (style, CSS)"/>
                            <CheckBox fx:id="embeddedFilterCheckBox" text="Вбудовані об'єкти (iframe, svg, медіа)"/>
                            <CheckBox fx:id="adFilterCheckBox" text="Реклама (ad, sponsor...)"/>
                            <CheckBox fx:id="navigationFilterCheckBox" text="Навігація (nav, footer, aside)"/>
                        </FlowPane>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="Керування сесією та кешем" styleClass="section-title"/>

                        <FlowPane hgap="8" vgap="8">
                            <Button fx:id="startButton" text="Запустити обхід"
                                    onAction="#onStartCrawl" styleClass="btn-primary"/>
                            <Button fx:id="pauseButton" text="Призупинити"
                                    onAction="#onPauseCrawl" styleClass="btn-warning"/>
                            <Button fx:id="resumeButton" text="Відновити"
                                    onAction="#onResumeCrawl" styleClass="btn-success"/>
                            <Button fx:id="stopButton" text="Зупинити"
                                    onAction="#onStopCrawl" styleClass="btn-danger"/>
                        </FlowPane>

                        <VBox spacing="4">
                            <Label text="Призупинені сесії (знімки стану):" styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="pausedSessionsComboBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                          promptText="Немає призупинених сесій"/>
                                <Button fx:id="refreshPausedButton" text="Оновити список"
                                        onAction="#onRefreshPausedSessions" styleClass="btn-secondary"/>
                            </HBox>
                        </VBox>

                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Термін дії кешу (год):" styleClass="field-label"/>
                            <Spinner fx:id="cacheTtlSpinner" editable="true" prefWidth="90"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="clearCacheButton" text="Очистити кеш"
                                    onAction="#onClearCache" styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="Розподілений обхід (P2P)" styleClass="section-title"/>

                        <VBox spacing="6">
                            <Label text="Роль ініціатора (координація сесії):" styleClass="field-label"/>
                            <FlowPane hgap="8" vgap="6" alignment="CENTER_LEFT">
                                <Label text="Порт:"/>
                                <TextField fx:id="initiatorPortField" text="9090" prefWidth="75"/>
                                <Button fx:id="createDistributedButton" text="Створити розподілену сесію"
                                        onAction="#onCreateDistributedSession" styleClass="btn-primary"/>
                                <Button fx:id="resumeDistributedButton" text="Відновити розподілену сесію"
                                        onAction="#onResumeDistributedSession" styleClass="btn-success"/>
                            </FlowPane>
                        </VBox>

                        <Separator/>

                        <VBox spacing="6">
                            <Label text="Роль вузла-учасника (підключення до ініціатора):" styleClass="field-label"/>
                            <FlowPane hgap="8" vgap="6" alignment="CENTER_LEFT">
                                <Label text="Хост:"/>
                                <TextField fx:id="workerHostField" text="127.0.0.1"
                                           promptText="IP або хост" prefWidth="135"/>
                                <Label text="Порт:"/>
                                <TextField fx:id="workerPortField" text="9090"
                                           promptText="Порт" prefWidth="70"/>
                                <Button fx:id="connectPeerButton" text="Підключитися"
                                        onAction="#onConnectPeer" styleClass="btn-success"/>
                                <Button fx:id="disconnectPeerButton" text="Відключитися"
                                        onAction="#onDisconnectPeer" styleClass="btn-danger"/>
                            </FlowPane>
                        </VBox>

                        <Separator/>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Підключені вузли:" styleClass="field-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="workersCountLabel" text="Активних виконавців: 1"
                                   styleClass="muted-label"/>
                        </HBox>

                        <TableView fx:id="peersTable" prefHeight="120" minHeight="95">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="peerIdColumn" text="ID вузла" prefWidth="130"/>
                                <TableColumn fx:id="peerHostColumn" text="Адреса" prefWidth="115"/>
                                <TableColumn fx:id="peerPortColumn" text="Порт" prefWidth="65"/>
                                <TableColumn fx:id="peerHeartbeatColumn" text="Останній сигнал" prefWidth="110"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>

        <VBox spacing="12" minWidth="450" styleClass="tab-content">
            <padding>
                <Insets top="14" right="14" bottom="14" left="12"/>
            </padding>

            <HBox spacing="10">
                <VBox styleClass="kpi-card, kpi-visited" spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Відвідано" styleClass="kpi-title"/>
                    <Label fx:id="visitedCountLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card, kpi-matched" spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Знайдено збігів" styleClass="kpi-title"/>
                    <Label fx:id="matchedCountLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card, kpi-errors" spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Помилок" styleClass="kpi-title"/>
                    <Label fx:id="errorCountLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card" spacing="2" HBox.hgrow="ALWAYS" prefWidth="150">
                    <Label text="Стан сесії" styleClass="kpi-title"/>
                    <Label fx:id="sessionStatusLabel" text="Очікування" styleClass="kpi-status-value"/>
                </VBox>
            </HBox>

            <SplitPane orientation="VERTICAL" dividerPositions="0.52" VBox.vgrow="ALWAYS"
                       styleClass="analytics-split-pane">
                <items>
                    <VBox styleClass="card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Дерево збережених результатів" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="treeSummaryLabel" text="0 сайтів" styleClass="muted-label"/>
                        </HBox>
                        <TreeView fx:id="siteTreeView" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox styleClass="card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Журнал подій та помилок" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="clearLogButton" text="Очистити журнал"
                                    onAction="#onClearLog" styleClass="btn-secondary, btn-compact"/>
                        </HBox>
                        <ListView fx:id="eventLogListView" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </items>
            </SplitPane>
        </VBox>
    </items>

</SplitPane>
